    <!-- MODAL THÊM / SỬA HỌC SINH -->
    <div id="add-student-modal" class="hidden fixed inset-0 bg-black/50 z-[110] flex justify-center items-center px-4">
        <div class="bg-white rounded-[1.5rem] shadow-2xl w-full max-w-3xl p-8 relative">
            <div class="flex justify-between items-center mb-6 border-b pb-4">
                <h3 class="text-2xl font-bold text-gray-900" id="student-modal-title">Thêm học sinh</h3>
                <button onclick="closeAddStudentModal()" class="text-gray-900 font-bold hover:text-red-500">Đóng</button>
            </div>
            <input type="hidden" id="editing-student-id">
            <div class="space-y-5">
                <div><label class="block text-sm font-bold text-gray-900 mb-2">Họ tên *</label><input type="text" id="st-name" placeholder="Ví dụ: Lâm Mẫn Nghi" class="w-full border border-gray-300 rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-[#0070f3]"></div>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                    <div><label class="block text-sm font-bold text-gray-900 mb-2">Mã học sinh *</label><input type="text" id="st-code" placeholder="Ví dụ: HS23" class="w-full border border-gray-300 rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-[#0070f3]"></div>
                    <div><label class="block text-sm font-bold text-gray-900 mb-2">Ngày sinh</label><input type="date" id="st-dob" class="w-full border border-gray-300 rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-[#0070f3] text-gray-600"></div>
                </div>
                <div>
                    <label class="block text-sm font-bold text-gray-900 mb-2">Giới tính</label>
                    <select id="st-gender" class="w-full border border-gray-300 rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-[#0070f3] bg-white">
                        <option value="">Chưa chọn</option><option value="Nam">Nam</option><option value="Nữ">Nữ</option>
                    </select>
                </div>
                <div><label class="block text-sm font-bold text-gray-900 mb-2">Ghi chú</label><textarea id="st-note" placeholder="Ghi chú thêm (không bắt buộc)" rows="3" class="w-full border border-gray-300 rounded-xl px-4 py-3 outline-none focus:ring-2 focus:ring-[#0070f3] resize-none"></textarea></div>
            </div>
            <div class="flex justify-end gap-3 mt-8 pt-4 border-t">
                <button onclick="closeAddStudentModal()" class="px-6 py-3 border border-gray-300 rounded-xl text-gray-700 font-bold hover:bg-gray-50 transition shadow-sm">Huỷ</button>
                <button onclick="submitNewStudent()" id="btn-submit-student" class="px-8 py-3 bg-[#0070F3] hover:bg-blue-700 text-white rounded-xl font-bold transition shadow-sm">Lưu học sinh</button>
            </div>
        </div>
    </div>


    <script>
        // KHỞI TẠO BIẾN
        let yearsData, currentYear, classesData, studentsData, weeksData, evalData, gradeData;
        let currentClassId = null;
        let isEditingClass = false; 
        let currentWeek = 9;
        let currentTerm = "hk1"; 

        function initData() {
            try {
                let hardcodedClasses = [
                    { "id": "c1", "year": "2026-2027", "name": "1/1 (ĐIỆP)", "grade": "Khối 1", "bg": "bg-indigo-50 border-indigo-100" },
                    { "id": "c2", "year": "2026-2027", "name": "3/1 (ANH)", "grade": "Khối 3", "bg": "bg-amber-50 border-amber-100" },
                    { "id": "c3", "year": "2026-2027", "name": "2/1 (ĐĂNG)", "grade": "Khối 2", "bg": "bg-blue-50 border-blue-100" }
                ];
                let hardcodedStudents = [
                    { "id": "s_1", "classId": "c3", "code": "HS001", "name": "Nguyễn Văn A", "dob": "2015-01-01", "gender": "Nam", "note": "" },
                    { "id": "s_2", "classId": "c3", "code": "HS002", "name": "Trần Văn b", "dob": "", "gender": "", "note": "" },
                    { "id": "s_3", "classId": "c3", "code": "HS003", "name": "Nguyễn Văn C", "dob": "", "gender": "", "note": "" },
                    { "id": "s_4", "classId": "c3", "code": "hs11", "name": "trần văn a", "dob": "", "gender": "", "note": "" }
                ];
                let hardcodedGrade = {
                    "s_1_hk1": { "lt": "4", "th": "4.5", "total": "9", "rank": "T" },
                    "s_2_hk1": { "lt": "", "th": "", "total": "0", "rank": "" },
                    "s_3_hk1": { "lt": "", "th": "", "total": "0", "rank": "" },
                    "s_4_hk1": { "lt": "", "th": "", "total": "0", "rank": "" }
                };

                yearsData = JSON.parse(localStorage.getItem('qllh_years')) || ["2026-2027"];
                currentYear = localStorage.getItem('qllh_current_year') || yearsData[0];
                
                classesData = JSON.parse(localStorage.getItem('qllh_classes_v52')) || JSON.parse(localStorage.getItem('qllh_classes_v50')) || hardcodedClasses;
                studentsData = JSON.parse(localStorage.getItem('qllh_students_v52')) || JSON.parse(localStorage.getItem('qllh_students_v50')) || hardcodedStudents;
                weeksData = JSON.parse(localStorage.getItem('qllh_weeks_v52')) || JSON.parse(localStorage.getItem('qllh_weeks_v50')) || {};
                evalData = JSON.parse(localStorage.getItem('qllh_eval_v52')) || JSON.parse(localStorage.getItem('qllh_eval_v50')) || {};
                gradeData = JSON.parse(localStorage.getItem('qllh_grade_v52')) || JSON.parse(localStorage.getItem('qllh_grade_v50')) || hardcodedGrade;
            } catch(e) {
                console.error("Lỗi khi load dữ liệu:", e);
                yearsData = ["2026-2027"]; currentYear = "2026-2027"; classesData = []; studentsData = []; weeksData = {}; evalData = {}; gradeData = {};
            }
        }

        function saveData() {
            try {
                localStorage.setItem('qllh_years', JSON.stringify(yearsData));
                localStorage.setItem('qllh_current_year', currentYear);
                localStorage.setItem('qllh_classes_v52', JSON.stringify(classesData));
                localStorage.setItem('qllh_students_v52', JSON.stringify(studentsData));
                localStorage.setItem('qllh_weeks_v52', JSON.stringify(weeksData));
                localStorage.setItem('qllh_eval_v52', JSON.stringify(evalData));
                localStorage.setItem('qllh_grade_v52', JSON.stringify(gradeData));
            } catch (e) { console.error("Lỗi khi lưu dữ liệu:", e); }
        }

        function switchTab(tabId) {
            try {
                document.querySelectorAll('.tab-content').forEach(tab => tab.classList.remove('active'));
                
                let navIds = ['nav-home', 'nav-class', 'nav-quiz', 'nav-material', 'nav-entertainment', 'nav-utilities'];
                navIds.forEach(id => {
                    let navEl = document.getElementById(id);
                    if(navEl) {
                        navEl.className = "w-full flex items-center gap-3 text-gray-600 hover:text-blue-600 hover:bg-blue-50 px-3 py-2.5 rounded-lg transition font-medium";
                        if(id === 'nav-class') navEl.className = "w-full flex items-center justify-between text-gray-600 hover:text-blue-600 hover:bg-blue-50 px-3 py-2.5 rounded-lg font-medium transition";
                    }
                });

                let targetTab = document.getElementById('tab-' + tabId);
                if(targetTab) targetTab.classList.add('active');
                
                let activeNav = document.getElementById('nav-' + tabId);
                if(activeNav) {
                    activeNav.className = "w-full flex items-center gap-3 text-blue-700 bg-blue-50 font-bold px-3 py-2.5 rounded-lg transition";
                    if(tabId === 'class-list' || tabId === 'class-detail') {
                        let navClass = document.getElementById('nav-class');
                        if(navClass) navClass.className = "w-full flex items-center justify-between text-blue-700 bg-blue-50 px-3 py-2.5 rounded-lg font-bold transition";
                    }
                }
                
                if (tabId === 'class-list') {
                    let subMenu = document.getElementById('class-submenu');
                    if(subMenu) subMenu.style.display = "block"; 
                    let actionContainer = document.getElementById('class-actions-container');
                    if(actionContainer) { actionContainer.classList.add('hidden'); actionContainer.classList.remove('flex'); }
                    currentClassId = null; 
                    let sidebarSelect = document.getElementById('sidebar-class-select');
                    if(sidebarSelect) sidebarSelect.value = "";
                } else if (tabId === 'class-detail') {
                    let subMenu = document.getElementById('class-submenu');
                    if(subMenu) subMenu.style.display = "block"; 
                } else {
                    let subMenu = document.getElementById('class-submenu');
                    if(subMenu) subMenu.style.display = "none"; 
                }
            } catch(e) { console.error("Lỗi khi chuyển tab:", e); }
        }

        function switchSubTab(subTabId) {
            try {
                document.querySelectorAll('.sub-tab-content').forEach(el => { el.classList.add('hidden'); el.classList.remove('block'); });
                ['week', 'student', 'grade'].forEach(id => {
                    let btn = document.getElementById('sub-nav-' + id);
                    if(btn) btn.className = "w-full flex items-center gap-3 px-3 py-2 text-gray-700 hover:bg-gray-50 rounded-lg text-sm font-medium transition";
                });
                const targetContent = document.getElementById('sub-tab-' + subTabId);
                if(targetContent) { targetContent.classList.remove('hidden'); targetContent.classList.add('block'); }
                const targetBtn = document.getElementById('sub-nav-' + subTabId);
                if(targetBtn) { targetBtn.className = "w-full flex items-center gap-3 px-3 py-2 bg-blue-50 text-[#0070f3] rounded-lg text-sm font-medium transition"; }
                
                if(subTabId === 'grade') {
                    let cls = classesData.find(c => c.id === currentClassId);
                    let titleEl = document.getElementById('grade-class-title');
                    if(cls && titleEl) titleEl.innerText = "Điểm học tập · " + cls.name;
                    renderGradeTable();
                }
            } catch(e) { console.error("Lỗi chuyển sub tab:", e); }
        }

        function loadYears() {
            try {
                const yearSelect = document.getElementById('sidebar-year-select'); 
                if(yearSelect) {
                    yearSelect.innerHTML = '';
                    yearsData.forEach(y => { yearSelect.innerHTML += `<option value="${y}" ${y === currentYear ? 'selected' : ''}>${y}</option>`; });
                }
                document.querySelectorAll('.display-current-year').forEach(el => el.innerText = currentYear);
                let newClassYear = document.getElementById('new-class-year');
                if(newClassYear) newClassYear.value = currentYear;
                renderClasses();
            } catch (e) { console.error("Lỗi khi loadYears:", e); }
        }
        
        function changeYear(val) { currentYear = val; saveData(); loadYears(); }
        function addYear() { let newYear = prompt("Nhập năm học mới:"); if (newYear && newYear.trim() !== "" && !yearsData.includes(newYear.trim())) { yearsData.push(newYear.trim()); currentYear = newYear.trim(); saveData(); loadYears(); } }
        function deleteCurrentYear() { if (yearsData.length <= 1) return alert("Không thể xóa năm học duy nhất!"); if (confirm(`Xóa toàn bộ dữ liệu năm học ${currentYear}?`)) { classesData = classesData.filter(c => c.year !== currentYear); yearsData = yearsData.filter(y => y !== currentYear); currentYear = yearsData[0]; saveData(); loadYears(); } }

        function renderClasses() {
            try {
                const container = document.getElementById('classes-grid'); const sidebarClass = document.getElementById('sidebar-class-select');
                if(container) container.innerHTML = ''; 
                if(sidebarClass) sidebarClass.innerHTML = '<option value="">Chọn lớp nhanh...</option>';
                
                let filteredClasses = classesData.filter(c => c.year === currentYear); 
                filteredClasses.sort((a, b) => a.name.localeCompare(b.name, 'vi', {numeric: true}));
                let totalStudentsGlobal = 0;

                filteredClasses.forEach(cls => {
                    let stdCount = studentsData.filter(s => s.classId === cls.id).length; totalStudentsGlobal += stdCount;
                    if(container) {
                        container.innerHTML += `
                            <div class="bg-white border hover:${cls.bg.split(' ')[1]} rounded-2xl p-5 shadow-sm hover:shadow-md transition relative group">
                                <div class="absolute top-4 right-4 flex gap-1.5 opacity-0 group-hover:opacity-100 transition-opacity">
                                    <button onclick="editClassFromCard('${cls.id}')" class="w-7 h-7 bg-white text-gray-500 hover:text-[#0070f3] border border-gray-200 rounded-full flex items-center justify-center shadow-sm"><i class="fas fa-pen text-[10px]"></i></button>
                                    <button onclick="deleteClassFromCard('${cls.id}')" class="w-7 h-7 bg-white text-gray-500 hover:text-red-500 border border-gray-200 rounded-full flex items-center justify-center shadow-sm"><i class="fas fa-trash text-[10px]"></i></button>
                                </div>
                                <div class="flex justify-between items-start mb-4 pr-16">
                                    <div><h4 class="font-black text-gray-900 text-lg">${cls.name}</h4><p class="text-xs text-gray-500 font-bold uppercase mt-1">${cls.grade}</p></div>
                                </div>
                                <div class="flex items-center justify-between">
                                    <p class="text-sm font-medium text-gray-600 bg-gray-100 px-3 py-1.5 rounded-lg flex items-center gap-2"><i class="fas fa-user-friends text-[#0070f3]"></i> ${stdCount} HS</p>
                                    <button onclick="openClassDetail('${cls.id}')" class="text-sm font-bold text-white bg-[#0070F3] px-4 py-2 rounded-lg hover:bg-blue-700 transition shadow-sm">Mở lớp <i class="fas fa-arrow-right text-xs ml-1"></i></button>
                                </div>
                            </div>`;
                    }
                    if(sidebarClass) { sidebarClass.innerHTML += `<option value="${cls.id}">${cls.name} - ${cls.grade}</option>`; }
                });

                if (currentClassId && sidebarClass) { 
                    sidebarClass.value = currentClassId; 
                    let actContainer = document.getElementById('class-actions-container');
                    if(actContainer) { actContainer.classList.remove('hidden'); actContainer.classList.add('flex'); }
                }

                let tcd = document.getElementById('total-classes-display'); if(tcd) tcd.innerText = filteredClasses.length; 
                let stcd = document.getElementById('sidebar-total-classes'); if(stcd) stcd.innerText = filteredClasses.length; 
                let tsd = document.getElementById('total-students-display'); if(tsd) tsd.innerText = totalStudentsGlobal;
            } catch (e) { console.error("Lỗi renderClasses:", e); }
        }

        function handleSidebarClassSelect(val) { if (val) { openClassDetail(val); } else { let ac = document.getElementById('class-actions-container'); if(ac) { ac.classList.add('hidden'); ac.classList.remove('flex'); } currentClassId = null; switchTab('class-list'); } }

        function openCreateClassModal() { isEditingClass = false; currentClassId = null; document.getElementById('class-modal-title').innerText = 'Tạo lớp'; document.getElementById('btn-submit-class').innerText = 'Tạo lớp'; document.getElementById('new-class-name').value = ''; document.getElementById('new-class-grade').value = ''; document.getElementById('create-class-modal').classList.remove('hidden'); setTimeout(() => document.getElementById('new-class-name').focus(), 100); }
        function editClassFromSidebar() { if(currentClassId) openEditClassModal(currentClassId); }
        function editClassFromCard(id) { openEditClassModal(id); }
        function openEditClassModal(id) { let cls = classesData.find(c => c.id === id); if(!cls) return; isEditingClass = true; currentClassId = id; document.getElementById('class-modal-title').innerText = 'Sửa lớp'; document.getElementById('btn-submit-class').innerText = 'Lưu thay đổi'; document.getElementById('new-class-name').value = cls.name; document.getElementById('new-class-grade').value = cls.grade.replace("Khối ", ""); document.getElementById('create-class-modal').classList.remove('hidden'); }
        function closeCreateClassModal() { document.getElementById('create-class-modal').classList.add('hidden'); }
        function submitNewClass() {
            let name = document.getElementById('new-class-name').value.trim(); let gradeVal = document.getElementById('new-class-grade').value.trim();
            if(!name || !gradeVal) return alert("Vui lòng điền tên lớp và số Khối!");
            let bgClass = "bg-gray-50"; if (gradeVal === "1" || gradeVal === "2") bgClass = "bg-indigo-50 border-indigo-200"; else if (gradeVal === "3") bgClass = "bg-amber-50 border-amber-200"; else if (gradeVal === "4" || gradeVal === "5") bgClass = "bg-teal-50 border-teal-200"; else bgClass = "bg-blue-50 border-blue-200"; 
            if (isEditingClass && currentClassId) { let cls = classesData.find(c => c.id === currentClassId); if(cls) { cls.name = name.toUpperCase(); cls.grade = "Khối " + gradeVal; cls.bg = bgClass; } } else { classesData.push({ id: "c_" + Date.now(), year: currentYear, name: name.toUpperCase(), grade: "Khối " + gradeVal, bg: bgClass }); } saveData(); closeCreateClassModal(); renderClasses(); if(isEditingClass && document.getElementById('tab-class-detail').classList.contains('active')) openClassDetail(currentClassId);
        }
        function deleteClassFromSidebar() { if(currentClassId) executeDeleteClass(currentClassId); }
        function deleteClassFromCard(id) { executeDeleteClass(id); }
        function executeDeleteClass(id) {
            let cls = classesData.find(c => c.id === id); let hsCount = studentsData.filter(s => s.classId === id).length;
            if(confirm(`Xóa lớp ${cls.name} và toàn bộ ${hsCount} học sinh?`)) {
                classesData = classesData.filter(c => c.id !== id); studentsData = studentsData.filter(s => s.classId !== id); saveData();
                if(currentClassId === id) { currentClassId = null; let ac = document.getElementById('class-actions-container'); if(ac) { ac.classList.add('hidden'); ac.classList.remove('flex'); } switchTab('class-list'); } else { renderClasses(); }
            }
        }

        function calculateAutoDates(targetWeek) {
            let closestWeekData = null; let weekDifference = 0;
            for (let i = targetWeek - 1; i >= 1; i--) { let key = currentClassId + "_" + i; if (weeksData[key] && weeksData[key].start && weeksData[key].end) { closestWeekData = weeksData[key]; weekDifference = targetWeek - i; break; } }
            if (!closestWeekData) { for (let i = targetWeek + 1; i <= 35; i++) { let key = currentClassId + "_" + i; if (weeksData[key] && weeksData[key].start && weeksData[key].end) { closestWeekData = weeksData[key]; weekDifference = targetWeek - i; break; } } }
            if (closestWeekData) {
                let startObj = new Date(closestWeekData.start); let endObj = new Date(closestWeekData.end);
                startObj.setDate(startObj.getDate() + (weekDifference * 7)); endObj.setDate(endObj.getDate() + (weekDifference * 7));
                let formatDate = (d) => { let month = '' + (d.getMonth() + 1), day = '' + d.getDate(), year = d.getFullYear(); if (month.length < 2) month = '0' + month; if (day.length < 2) day = '0' + day; return [year, month, day].join('-'); };
                return { start: formatDate(startObj), end: formatDate(endObj) };
            }
            return null; 
        }

        function renderWeekSelector() {
            const container = document.getElementById('week-selector'); if(!container) return;
            container.innerHTML = '';
            let lblDisp = document.getElementById('week-label-display');
            if(lblDisp) lblDisp.innerText = "TUẦN " + currentWeek + "/35";
            document.querySelectorAll('.display-current-week-label').forEach(el => el.innerText = "Tuần " + currentWeek);
            document.querySelectorAll('.display-current-week-label-table').forEach(el => el.innerText = currentWeek);

            for (let i = 1; i <= 35; i++) {
                let isActive = (i === currentWeek); let weekKey = currentClassId + "_" + i; let hasData = weeksData[weekKey] && (weeksData[weekKey].start || weeksData[weekKey].end);
                let btnClass = "w-[38px] h-[38px] rounded-full flex flex-col justify-center items-center text-[13px] cursor-pointer transition border relative shrink-0 ";
                btnClass += isActive ? "bg-[#0070f3] text-white font-bold border-[#0070f3]" : "bg-white text-gray-600 font-medium hover:bg-gray-100 border-gray-200";
                let dotHTML = hasData ? '<div class="absolute bottom-[4px] w-1 h-1 rounded-full ' + (isActive ? 'bg-white' : 'bg-[#0070f3]') + '"></div>' : "";
                container.innerHTML += '<div onclick="selectWeek(' + i + ')" class="' + btnClass + '"><span class="' + (hasData ? 'mb-[5px]' : '') + '">' + i + '</span>' + dotHTML + '</div>';
            }
        }

        function selectWeek(weekNum) {
            currentWeek = weekNum; renderWeekSelector();
            let weekKey = currentClassId + "_" + currentWeek;
            let inputStart = document.getElementById('week-start-date'); let inputEnd = document.getElementById('week-end-date'); let hintAuto = document.getElementById('date-auto-hint');
            
            if(inputStart && inputEnd && hintAuto) {
                if(weeksData[weekKey] && weeksData[weekKey].start && weeksData[weekKey].end) {
                    inputStart.value = weeksData[weekKey].start; inputEnd.value = weeksData[weekKey].end; hintAuto.classList.add('hidden'); 
                } else {
                    let autoDates = calculateAutoDates(currentWeek);
                    if (autoDates) { inputStart.value = autoDates.start; inputEnd.value = autoDates.end; hintAuto.classList.remove('hidden'); } 
                    else { inputStart.value = ''; inputEnd.value = ''; hintAuto.classList.add('hidden'); }
                }
            }
            
            let evalSelId = document.getElementById('eval-student-selected-id');
            if(evalSelId && evalSelId.value) { loadEvalStudentData(); }
        }

        function saveWeekDates() {
            if(!currentClassId) return;
            let inputStart = document.getElementById('week-start-date'); let inputEnd = document.getElementById('week-end-date');
            if(!inputStart || !inputEnd) return;
            let startDate = inputStart.value; let endDate = inputEnd.value;
            let weekKey = currentClassId + "_" + currentWeek; weeksData[weekKey] = { start: startDate, end: endDate };
            saveData(); let hintAuto = document.getElementById('date-auto-hint'); if(hintAuto) hintAuto.classList.add('hidden'); 
            renderWeekSelector(); 
            let btn = event.currentTarget; let originalHTML = btn.innerHTML;
            btn.innerHTML = `<i class="fas fa-check"></i> Đã lưu`; btn.classList.replace('bg-[#0070f3]', 'bg-emerald-500');
            setTimeout(() => { btn.innerHTML = originalHTML; btn.classList.replace('bg-emerald-500', 'bg-[#0070f3]'); }, 1200);
        }

        function loadEvalStudentSelect() {
            const dropdown = document.getElementById('eval-student-dropdown'); if(!dropdown) return;
            dropdown.innerHTML = '';
            let classStudents = studentsData.filter(s => s.classId === currentClassId);
            if(classStudents.length === 0) { dropdown.innerHTML = '<div class="p-4 text-gray-500 text-sm font-medium">Lớp chưa có học sinh. Vui lòng thêm học sinh.</div>'; return; }
            classStudents.forEach(st => {
                dropdown.innerHTML += '<div class="student-option px-5 py-3 hover:bg-blue-50 cursor-pointer text-[15px] font-medium text-gray-800 border-b border-gray-100 last:border-0 transition" onclick="selectEvalStudent(\'' + st.id + '\', \'' + st.name + '\', \'' + st.code + '\')">' + st.name + ' <span class="text-gray-500 text-sm">(' + st.code + ')</span></div>';
            });
        }

        function filterEvalStudents() {
            let searchEl = document.getElementById('eval-student-search'); let dropdown = document.getElementById('eval-student-dropdown');
            if(!searchEl || !dropdown) return;
            let input = searchEl.value.toLowerCase(); let options = document.querySelectorAll('.student-option'); 
            if(input.trim() === '') { document.getElementById('eval-student-selected-id').value = ''; document.getElementById('eval-content-area').classList.add('hidden'); document.getElementById('eval-empty-state').classList.remove('hidden'); }
            options.forEach(opt => { if(opt.innerText.toLowerCase().includes(input)) { opt.style.display = "block"; } else { opt.style.display = "none"; } });
            dropdown.classList.remove('hidden');
        }

        function selectEvalStudent(id, name, code) {
            let selId = document.getElementById('eval-student-selected-id'); let searchEl = document.getElementById('eval-student-search'); let dropdown = document.getElementById('eval-student-dropdown');
            if(selId) selId.value = id; if(searchEl) searchEl.value = name + " (" + code + ")"; if(dropdown) dropdown.classList.add('hidden'); 
            loadEvalStudentData(); 
        }

        document.addEventListener('click', function(e) {
            let searchBox = document.getElementById('eval-student-search'); let dropdown = document.getElementById('eval-student-dropdown');
            if (searchBox && dropdown && e.target !== searchBox && !dropdown.contains(e.target)) { dropdown.classList.add('hidden'); }
        });

        function loadEvalStudentData() {
            let selId = document.getElementById('eval-student-selected-id'); if(!selId) return;
            const stId = selId.value; let contentArea = document.getElementById('eval-content-area'); let emptyState = document.getElementById('eval-empty-state');
            if(!stId) { if(contentArea) contentArea.classList.add('hidden'); if(emptyState) emptyState.classList.remove('hidden'); return; }
