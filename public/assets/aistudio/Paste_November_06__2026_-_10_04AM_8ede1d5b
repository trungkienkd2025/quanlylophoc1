        function colLetterToIndex(letter) {
            let col = 0; let length = letter.length;
            for (let i = 0; i < length; i++) { col += (letter.charCodeAt(i) - 64) * Math.pow(26, length - i - 1); }
            return col - 1;
        }

        // CÔNG CỤ 1: Sắp xếp 1 file
        function processExternalExcelSort() {
            let colInput = document.getElementById('util-sort-col').value.trim().toUpperCase();
            let startRowInput = document.getElementById('util-sort-start').value.trim();
            let endRowInput = document.getElementById('util-sort-end').value.trim();
            let fileInput = document.getElementById('util-sort-file');

            if (!colInput) return alert("Vui lòng nhập tên cột cần sắp xếp (Ví dụ: B, C...)");
            if (!startRowInput || !endRowInput) return alert("Vui lòng nhập Từ dòng và Đến dòng!");
            if (!fileInput.files.length) return alert("Vui lòng chọn một file Excel từ máy tính!");

            let startRow = parseInt(startRowInput) - 1; let endRow = parseInt(endRowInput) - 1;
            if (startRow > endRow || startRow < 0) return alert("Khoảng dòng không hợp lệ!");

            let file = fileInput.files[0]; let colIndex = colLetterToIndex(colInput);
            if (colIndex < 0) return alert("Tên cột không hợp lệ!");

            let reader = new FileReader();
            reader.onload = function(e) {
                try {
                    let data = new Uint8Array(e.target.result); let workbook = XLSX.read(data, {type: 'array'});
                    let firstSheetName = workbook.SheetNames[0]; let worksheet = workbook.Sheets[firstSheetName];
                    let rows = XLSX.utils.sheet_to_json(worksheet, {header: 1, defval: ""});
                    
                    if (rows.length === 0) return alert("File không có dữ liệu!");
                    if (endRow >= rows.length) endRow = rows.length - 1;

                    let topPart = rows.slice(0, startRow); let sortPart = rows.slice(startRow, endRow + 1); let bottomPart = rows.slice(endRow + 1);

                    sortPart.sort((a, b) => {
                        let nameA = (a[colIndex] || "").toString().trim().split(' ').pop();
                        let nameB = (b[colIndex] || "").toString().trim().split(' ').pop();
                        return nameA.localeCompare(nameB, 'vi');
                    });

                    let sortedRows = topPart.concat(sortPart).concat(bottomPart);
                    let newWs = XLSX.utils.aoa_to_sheet(sortedRows);
                    if(worksheet['!cols']) newWs['!cols'] = worksheet['!cols'];
                    if(worksheet['!merges']) newWs['!merges'] = worksheet['!merges']; 

                    let newWb = XLSX.utils.book_new(); XLSX.utils.book_append_sheet(newWb, newWs, firstSheetName);
                    let originalName = file.name.split('.')[0]; XLSX.writeFile(newWb, originalName + "_Da_Sap_Xep.xlsx");
                    
                    fileInput.value = ""; updateUtilFileName(fileInput, 'file-name-display');
                } catch (error) { console.error(error); alert("Đã xảy ra lỗi khi xử lý file."); }
            };
            reader.readAsArrayBuffer(file);
        }

        // CÔNG CỤ 2: Đồng bộ 2 file
        function processExcelSync() {
            let col1 = document.getElementById('sync-col-1').value.trim().toUpperCase();
            let start1 = parseInt(document.getElementById('sync-start-1').value.trim()) - 1;
            let end1 = parseInt(document.getElementById('sync-end-1').value.trim()) - 1;
            let file1 = document.getElementById('util-sync-file-1').files[0];

            let col2 = document.getElementById('sync-col-2').value.trim().toUpperCase();
            let start2 = parseInt(document.getElementById('sync-start-2').value.trim()) - 1;
            let end2 = parseInt(document.getElementById('sync-end-2').value.trim()) - 1;
            let file2 = document.getElementById('util-sync-file-2').files[0];

            if(!col1 || isNaN(start1) || isNaN(end1) || !file1) return alert("Vui lòng điền đủ thông tin và chọn File Mẫu (File 1)!");
            if(!col2 || isNaN(start2) || isNaN(end2) || !file2) return alert("Vui lòng điền đủ thông tin và chọn File Cần Xử Lý (File 2)!");
            if(start1 < 0 || start1 > end1 || start2 < 0 || start2 > end2) return alert("Khoảng dòng không hợp lệ!");

            let idx1 = colLetterToIndex(col1); let idx2 = colLetterToIndex(col2);
            if(idx1 < 0 || idx2 < 0) return alert("Tên cột không hợp lệ!");

            let refOrderList = []; // Chứa danh sách tên từ File 1

            // Bước 1: Đọc File 1 để lấy thứ tự chuẩn
            let reader1 = new FileReader();
            reader1.onload = function(e1) {
                try {
                    let data1 = new Uint8Array(e1.target.result); let wb1 = XLSX.read(data1, {type: 'array'});
                    let rows1 = XLSX.utils.sheet_to_json(wb1.Sheets[wb1.SheetNames[0]], {header: 1, defval: ""});
                    
                    let actualEnd1 = Math.min(end1, rows1.length - 1);
                    for(let i = start1; i <= actualEnd1; i++) {
                        let rawName = (rows1[i][idx1] || "").toString().trim().toLowerCase();
                        if(rawName) refOrderList.push(rawName);
                    }

                    if(refOrderList.length === 0) return alert("Không tìm thấy tên nào trong khoảng dòng của File Mẫu!");

                    // Bước 2: Đọc File 2 và sắp xếp theo mảng refOrderList
                    let reader2 = new FileReader();
                    reader2.onload = function(e2) {
                        try {
                            let data2 = new Uint8Array(e2.target.result); let wb2 = XLSX.read(data2, {type: 'array'});
                            let ws2 = wb2.Sheets[wb2.SheetNames[0]];
                            let rows2 = XLSX.utils.sheet_to_json(ws2, {header: 1, defval: ""});

                            let actualEnd2 = Math.min(end2, rows2.length - 1);
                            let topPart = rows2.slice(0, start2);
                            let sortPart = rows2.slice(start2, actualEnd2 + 1);
                            let bottomPart = rows2.slice(actualEnd2 + 1);

                            // Sắp xếp
                            sortPart.sort((a, b) => {
                                let nameA = (a[idx2] || "").toString().trim().toLowerCase();
                                let nameB = (b[idx2] || "").toString().trim().toLowerCase();
                                
                                let posA = refOrderList.indexOf(nameA);
                                let posB = refOrderList.indexOf(nameB);
                                
                                // Nếu không tìm thấy trong file mẫu, đẩy xuống cuối
                                if(posA === -1) posA = 9999;
                                if(posB === -1) posB = 9999;

                                if (posA !== posB) return posA - posB;
                                return nameA.localeCompare(nameB, 'vi'); // Nếu trùng vị trí, xếp theo alphabet
                            });

                            let sortedRows = topPart.concat(sortPart).concat(bottomPart);
                            let newWs = XLSX.utils.aoa_to_sheet(sortedRows);
                            
                            if(ws2['!cols']) newWs['!cols'] = ws2['!cols'];
                            if(ws2['!merges']) newWs['!merges'] = ws2['!merges']; 

                            let newWb = XLSX.utils.book_new(); XLSX.utils.book_append_sheet(newWb, newWs, "Dong_bo");
                            let originalName = file2.name.split('.')[0]; 
                            XLSX.writeFile(newWb, originalName + "_Da_Dong_Bo.xlsx");

                            // Reset Inputs
                            document.getElementById('util-sync-file-1').value = ""; updateUtilFileName(document.getElementById('util-sync-file-1'), 'file-name-sync-1', 'emerald');
                            document.getElementById('util-sync-file-2').value = ""; updateUtilFileName(document.getElementById('util-sync-file-2'), 'file-name-sync-2', 'emerald');

                        } catch(err) { console.error(err); alert("Lỗi khi đọc File 2."); }
                    };
                    reader2.readAsArrayBuffer(file2);
                } catch(err) { console.error(err); alert("Lỗi khi đọc File Mẫu (File 1)."); }
            };
            reader1.readAsArrayBuffer(file1);
        }

