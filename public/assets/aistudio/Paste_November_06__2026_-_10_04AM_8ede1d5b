<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hệ Thống Quản Lý Lớp Học - QLLH.Pro</title>
    
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
    
    <style>
        ::-webkit-scrollbar { width: 6px; height: 6px; }
        ::-webkit-scrollbar-track { background: #f1f1f1; }
        ::-webkit-scrollbar-thumb { background: #c1c1c1; border-radius: 10px; }
        ::-webkit-scrollbar-thumb:hover { background: #a8a8a8; }
        
        .tab-content, .sub-tab-content { display: none; }
        .tab-content.active, .sub-tab-content.active { display: block; animation: fadeIn 0.2s ease-in-out; }
        @keyframes fadeIn { from { opacity: 0; transform: translateY(5px); } to { opacity: 1; transform: translateY(0); } }
        
        td[contenteditable="true"], input.editable-input, select.editable-input { outline: none; transition: background 0.2s; cursor: text; }
        td[contenteditable="true"]:focus, input.editable-input:focus, select.editable-input:focus { background-color: #eef2ff; }
        td[contenteditable="true"]:empty:before { content: "\feff"; }

        .btn-option { transition: all 0.2s; border: 1px solid #e5e7eb; padding: 6px 14px; border-radius: 20px; font-size: 13px; font-weight: 600; color: #4b5563; background: white; cursor: pointer; }
        .btn-option:hover { border-color: #0070f3; color: #0070f3; background: #eff6ff; }
        .btn-option.selected { border-color: #0070f3; color: white; background: #0070f3; }
        
        .grade-input { width: 80px; text-align: center; border: 1px solid #e5e7eb; border-radius: 8px; padding: 6px; outline: none; font-weight: 600; }
        .grade-input:focus { border-color: #0070f3; box-shadow: 0 0 0 2px rgba(0, 112, 243, 0.2); }
        .grade-total { width: 60px; text-align: center; font-weight: 700; background: #f3f4f6; padding: 6px; border-radius: 8px; }
        .grade-rank { width: 60px; text-align: center; font-weight: 800; background: transparent; border: none; outline: none; }
    </style>
</head>
<body class="bg-gray-50 font-sans text-gray-800 flex h-screen overflow-hidden relative">

    <!-- SIDEBAR -->
    <aside class="w-64 bg-white border-r border-gray-200 flex flex-col h-full overflow-y-auto shrink-0">
        <div class="p-5 border-b flex items-center justify-between">
            <h1 class="text-2xl font-black text-blue-700 tracking-tight">QLLH<span class="text-amber-500">.Pro</span></h1>
            <button class="text-gray-400 hover:text-blue-600"><i class="fas fa-bars"></i></button>
        </div>

        <nav class="flex-1 px-4 py-4 space-y-1">
            <button onclick="switchTab('home')" id="nav-home" class="w-full flex items-center gap-3 text-blue-700 bg-blue-50 font-bold px-3 py-2.5 rounded-lg transition">
                <i class="fas fa-home w-5 text-center"></i> <span>Trang chủ</span>
            </button>
            
            <div class="space-y-1">
                <button onclick="switchTab('class-list')" id="nav-class" class="w-full flex items-center justify-between text-gray-600 hover:text-blue-600 hover:bg-gray-50 px-3 py-2.5 rounded-lg font-medium transition">
                    <div class="flex items-center gap-3">
                        <i class="fas fa-book w-5 text-center"></i> <span>Năm học</span>
                    </div>
                    <i class="fas fa-chevron-down text-sm"></i>
                </button>
                
                <div class="pl-5 pr-2 py-2 space-y-3" id="class-submenu" style="display: none;">
                    <div class="flex justify-between items-center text-sm font-bold text-gray-800 mb-2 pl-3">
                        <select id="sidebar-year-select" onchange="changeYear(this.value)" class="bg-transparent outline-none cursor-pointer text-gray-900 text-[15px] font-bold">
                        </select>
                        <span class="text-xs text-gray-500 font-bold" id="sidebar-total-classes">0</span>
                    </div>
                    
                    <div class="border border-[#0070f3] rounded-[1rem] p-1 bg-white relative shadow-sm transition-all duration-200 mx-2">
                        <select id="sidebar-class-select" onchange="handleSidebarClassSelect(this.value)" class="w-full py-1.5 px-3 text-[14px] font-medium outline-none text-[#0070f3] bg-transparent cursor-pointer appearance-none truncate">
                            <option value="">Chọn lớp nhanh...</option>
                        </select>
                        <i class="fas fa-chevron-down absolute top-3 right-4 text-xs text-[#0070f3]"></i>
                    </div>

                    <div id="class-actions-container" class="hidden flex-col gap-2 mt-3 mx-2">
                        <div class="flex gap-2">
                            <button onclick="editClassFromSidebar()" class="flex-1 border border-gray-200 rounded-3xl py-1.5 text-sm font-medium text-gray-800 hover:bg-gray-50 transition shadow-sm bg-white">Sửa lớp</button>
                            <button onclick="deleteClassFromSidebar()" class="flex-1 border border-gray-200 rounded-3xl py-1.5 text-sm font-medium text-gray-800 hover:bg-red-50 hover:text-red-600 hover:border-red-200 transition shadow-sm bg-white">Xóa lớp</button>
                        </div>
                        <div class="space-y-1 mt-3 pl-1">
                            <button onclick="switchSubTab('week')" id="sub-nav-week" class="w-full flex items-center gap-3 px-3 py-2 bg-blue-50/70 text-[#0070f3] rounded-lg text-sm font-medium transition">
                                <i class="fas fa-clipboard-check w-4"></i> Tuần
                            </button>
                            <button onclick="switchSubTab('student')" id="sub-nav-student" class="w-full flex items-center gap-3 px-3 py-2 text-gray-700 hover:bg-gray-50 rounded-lg text-sm font-medium transition">
                                <i class="fas fa-user-friends w-4"></i> Học sinh
                            </button>
                            <button onclick="switchSubTab('grade')" id="sub-nav-grade" class="w-full flex items-center gap-3 px-3 py-2 text-gray-700 hover:bg-gray-50 rounded-lg text-sm font-medium transition">
                                <i class="fas fa-graduation-cap w-4"></i> Điểm
                            </button>
                        </div>
                    </div>
                </div>
            </div>

            <button onclick="switchTab('quiz')" id="nav-quiz" class="w-full flex items-center gap-3 text-gray-600 hover:text-blue-600 hover:bg-gray-50 px-3 py-2.5 rounded-lg transition font-medium">
                <i class="fas fa-graduation-cap w-5 text-center"></i> <span>Trắc nghiệm</span>
            </button>
            <button onclick="switchTab('material')" id="nav-material" class="w-full flex items-center gap-3 text-gray-600 hover:text-blue-600 hover:bg-gray-50 px-3 py-2.5 rounded-lg transition font-medium">
                <i class="fas fa-video w-5 text-center"></i> <span>Học liệu số</span>
            </button>
            <button onclick="switchTab('entertainment')" id="nav-entertainment" class="w-full flex items-center gap-3 text-gray-600 hover:text-blue-600 hover:bg-gray-50 px-3 py-2.5 rounded-lg transition font-medium">
                <i class="fas fa-gamepad w-5 text-center"></i> <span>Giải trí</span>
            </button>
            <button onclick="switchTab('utilities')" id="nav-utilities" class="w-full flex items-center gap-3 text-gray-600 hover:text-blue-600 hover:bg-gray-50 px-3 py-2.5 rounded-lg transition font-medium">
                <i class="fas fa-tools w-5 text-center"></i> <span>Tiện ích</span>
            </button>
        </nav>

        <div class="p-4 border-t border-gray-200 bg-gray-50/50">
            <div class="bg-white border rounded-xl p-3 mb-3 relative overflow-hidden shadow-sm">
                <div class="absolute top-0 left-0 w-1 h-full bg-[#0070f3]"></div>
                <div class="text-[10px] text-gray-500 font-bold mb-0.5 uppercase tracking-wider pl-2">Mã phòng học</div>
                <div class="font-black text-blue-700 tracking-widest text-lg pl-2">F08AF1</div>
            </div>
            <div class="flex justify-between items-center px-1">
                <div class="font-bold text-sm text-gray-800 truncate">trungkienkd2025</div>
                <button class="text-red-500 hover:text-red-700 transition bg-red-50 p-1.5 rounded-lg" title="Đăng xuất"><i class="fas fa-sign-out-alt"></i></button>
            </div>
        </div>
    </aside>

    <main class="flex-1 overflow-y-auto bg-[#f8faff] relative">
        
        <!-- TAB 1: TRANG CHỦ -->
        <div id="tab-home" class="tab-content active p-8 xl:p-10 max-w-7xl mx-auto">
            <div class="mb-10">
                <p class="text-gray-500 text-[15px] font-bold mb-1">Xin chào,</p>
                <h2 class="text-4xl font-black text-gray-900 tracking-tight">Thầy Trần Trung Kiên</h2>
                <p class="text-gray-600 mt-2 font-medium">Chọn khu vực cần quản lý để bắt đầu công việc trong lớp.</p>
            </div>

            <div class="bg-white border border-blue-100 rounded-2xl p-6 shadow-sm mb-10 flex flex-col items-center justify-center relative overflow-hidden">
                <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-blue-400 to-blue-600"></div>
                <p class="text-xs font-bold text-blue-500 uppercase tracking-widest mb-1">Mã phòng học</p>
                <h3 class="text-4xl font-black text-gray-900 tracking-widest">F08AF1</h3>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
                <div onclick="switchTab('class-list')" class="bg-white border border-gray-200 rounded-2xl p-6 cursor-pointer hover:-translate-y-1 hover:shadow-lg transition-all duration-300 group">
                    <div class="w-12 h-12 bg-blue-500 rounded-full flex items-center justify-center text-white text-xl mb-4 group-hover:scale-110 transition-transform shadow-md shadow-blue-200">
                        <i class="fas fa-user-friends"></i>
                    </div>
                    <h3 class="font-bold text-gray-900 text-lg mb-1 group-hover:text-blue-600 transition-colors">Quản lý lớp học</h3>
                    <p class="text-sm text-gray-500 leading-relaxed font-medium">Quản lý học sinh, điểm danh, phát biểu và điểm thi đua</p>
                </div>
                <div onclick="switchTab('quiz')" class="bg-white border border-gray-200 rounded-2xl p-6 cursor-pointer hover:-translate-y-1 hover:shadow-lg transition-all duration-300 group">
                    <div class="w-12 h-12 bg-emerald-500 rounded-full flex items-center justify-center text-white text-xl mb-4 group-hover:scale-110 transition-transform shadow-md shadow-emerald-200">
                        <i class="fas fa-graduation-cap"></i>
                    </div>
                    <h3 class="font-bold text-gray-900 text-lg mb-1 group-hover:text-emerald-600 transition-colors">Câu hỏi trắc nghiệm</h3>
                    <p class="text-sm text-gray-500 leading-relaxed font-medium">Quản lý ngân hàng câu hỏi trắc nghiệm Tin học</p>
                </div>
                <div onclick="switchTab('material')" class="bg-white border border-gray-200 rounded-2xl p-6 cursor-pointer hover:-translate-y-1 hover:shadow-lg transition-all duration-300 group">
                    <div class="w-12 h-12 bg-purple-500 rounded-full flex items-center justify-center text-white text-xl mb-4 group-hover:scale-110 transition-transform shadow-md shadow-purple-200">
                        <i class="fas fa-video"></i>
                    </div>
                    <h3 class="font-bold text-gray-900 text-lg mb-1 group-hover:text-purple-600 transition-colors">Học liệu số</h3>
                    <p class="text-sm text-gray-500 leading-relaxed font-medium">Quản lý liên kết video bài giảng theo khối lớp 1-5</p>
                </div>
                <div onclick="switchTab('entertainment')" class="bg-white border border-gray-200 rounded-2xl p-6 cursor-pointer hover:-translate-y-1 hover:shadow-lg transition-all duration-300 group">
                    <div class="w-12 h-12 bg-amber-500 rounded-full flex items-center justify-center text-white text-xl mb-4 group-hover:scale-110 transition-transform shadow-md shadow-amber-200">
                        <i class="fas fa-gamepad"></i>
                    </div>
                    <h3 class="font-bold text-gray-900 text-lg mb-1 group-hover:text-amber-600 transition-colors">Giải trí</h3>
                    <p class="text-sm text-gray-500 leading-relaxed font-medium">Không gian trò chơi và hoạt động thư giãn cho lớp học</p>
                </div>
                <div onclick="switchTab('utilities')" class="bg-white border border-gray-200 rounded-2xl p-6 cursor-pointer hover:-translate-y-1 hover:shadow-lg transition-all duration-300 group">
                    <div class="w-12 h-12 bg-rose-500 rounded-full flex items-center justify-center text-white text-xl mb-4 group-hover:scale-110 transition-transform shadow-md shadow-rose-200">
                        <i class="fas fa-tools"></i>
                    </div>
                    <h3 class="font-bold text-gray-900 text-lg mb-1 group-hover:text-rose-600 transition-colors">Tiện ích</h3>
                    <p class="text-sm text-gray-500 leading-relaxed font-medium">Nhập danh sách, tiện ích thao tác Excel thông minh</p>
                </div>
            </div>
        </div>

        <!-- CÁC TAB CHỨC NĂNG -->
        <div id="tab-quiz" class="tab-content p-8 max-w-6xl mx-auto">
            <h2 class="text-3xl font-black text-gray-900 tracking-tight mb-6">Ngân hàng Câu hỏi Trắc nghiệm</h2>
            <div class="bg-white p-10 rounded-2xl shadow-sm border border-gray-200 text-center">
                <i class="fas fa-server text-5xl text-emerald-300 mb-4"></i>
                <h3 class="text-xl font-bold text-gray-800 mb-2">Tính năng đang xây dựng</h3>
                <p class="text-gray-500">Khu vực này sẽ cho phép thầy thêm, sửa, xóa và xuất PDF các câu hỏi trắc nghiệm Tin học.</p>
            </div>
        </div>
        
        <div id="tab-material" class="tab-content p-8 max-w-6xl mx-auto">
            <h2 class="text-3xl font-black text-gray-900 tracking-tight mb-6">Học liệu số & Video bài giảng</h2>
            <div class="bg-white p-10 rounded-2xl shadow-sm border border-gray-200 text-center">
                <i class="fas fa-photo-video text-5xl text-purple-300 mb-4"></i>
                <h3 class="text-xl font-bold text-gray-800 mb-2">Tính năng đang xây dựng</h3>
                <p class="text-gray-500">Quản lý link YouTube, Drive theo từng khối lớp từ 1 đến 5.</p>
            </div>
        </div>
        
        <div id="tab-entertainment" class="tab-content p-8 max-w-6xl mx-auto">
            <h2 class="text-3xl font-black text-gray-900 tracking-tight mb-6">Giải trí & Quiz Game</h2>
            <div class="bg-white p-10 rounded-2xl shadow-sm border border-gray-200 text-center">
                <i class="fas fa-dice text-5xl text-amber-300 mb-4"></i>
                <h3 class="text-xl font-bold text-gray-800 mb-2">Tính năng đang xây dựng</h3>
                <p class="text-gray-500">Tích hợp các trò chơi khởi động, vòng quay may mắn cho lớp học.</p>
            </div>
        </div>

        <!-- ========================================== -->
        <!-- TAB TIỆN ÍCH (ĐÃ CẬP NHẬT GIAO DIỆN MỚI CHO EXCEL) -->
        <!-- ========================================== -->
        <div id="tab-utilities" class="tab-content p-8 max-w-7xl mx-auto">
            <h2 class="text-3xl font-black text-gray-900 tracking-tight mb-6">Tiện ích hỗ trợ Excel & Lớp học</h2>
            
            <div class="grid grid-cols-1 xl:grid-cols-2 gap-8 mb-8">
                
                <!-- CÔNG CỤ 1: SẮP XẾP EXCEL CHUẨN A-Z -->
                <div class="bg-white p-7 rounded-3xl shadow-sm border border-gray-200 flex flex-col h-full hover:shadow-md transition">
                    <div class="flex items-center gap-4 mb-4">
                        <div class="w-12 h-12 bg-blue-50 text-blue-600 rounded-2xl flex items-center justify-center text-xl shrink-0"><i class="fas fa-sort-alpha-down"></i></div>
                        <div>
                            <h3 class="text-xl font-bold text-gray-900">Sắp xếp Excel ngoài</h3>
                            <p class="text-sm text-gray-500 font-medium mt-0.5">Sắp xếp dữ liệu theo thứ tự bảng chữ cái (Họ Tên).</p>
                        </div>
                    </div>
                    
                    <div class="space-y-4 mt-2">
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-3">
                            <div class="flex items-center gap-2 bg-gray-50 px-3 py-2.5 rounded-xl border border-gray-200">
                                <label class="text-sm font-bold text-gray-700 whitespace-nowrap">Cột tên:</label>
                                <input type="text" id="util-sort-col" placeholder="VD: B" class="bg-transparent w-full uppercase outline-none text-sm font-black text-blue-600 text-center">
                            </div>
                            <div class="flex items-center gap-2 bg-gray-50 px-3 py-2.5 rounded-xl border border-gray-200">
                                <label class="text-sm font-bold text-gray-700 whitespace-nowrap">Từ dòng:</label>
                                <input type="number" id="util-sort-start" min="1" placeholder="VD: 5" class="bg-transparent w-full outline-none text-sm font-black text-blue-600 text-center">
                            </div>
                            <div class="flex items-center gap-2 bg-gray-50 px-3 py-2.5 rounded-xl border border-gray-200">
                                <label class="text-sm font-bold text-gray-700 whitespace-nowrap">Đến dòng:</label>
                                <input type="number" id="util-sort-end" min="1" placeholder="VD: 40" class="bg-transparent w-full outline-none text-sm font-black text-blue-600 text-center">
                            </div>
                        </div>

                        <label class="w-full flex flex-col items-center justify-center gap-2 bg-blue-50/50 hover:bg-blue-50 border-2 border-dashed border-blue-200 hover:border-blue-400 text-blue-700 p-6 rounded-2xl font-bold cursor-pointer transition">
                            <i class="fas fa-file-excel text-3xl mb-1 opacity-70"></i>
                            <span id="file-name-display">Bấm để chọn file Excel cần sắp xếp</span>
                            <input type="file" id="util-sort-file" accept=".xlsx, .xls" class="hidden" onchange="updateUtilFileName(this, 'file-name-display')">
                        </label>
                        
                        <button onclick="processExternalExcelSort()" class="w-full bg-[#0070f3] hover:bg-blue-700 text-white py-3.5 rounded-xl font-bold transition flex items-center justify-center gap-2 shadow-sm text-sm">
                            <i class="fas fa-magic"></i> Sắp xếp & Tải về máy
                        </button>
                    </div>
                </div>

                <!-- CÔNG CỤ 2: ĐỒNG BỘ THỨ TỰ (SYNC EXCEL) -->
                <div class="bg-white p-7 rounded-3xl shadow-sm border border-gray-200 flex flex-col h-full hover:shadow-md transition">
                    <div class="flex items-center gap-4 mb-4">
                        <div class="w-12 h-12 bg-emerald-50 text-emerald-600 rounded-2xl flex items-center justify-center text-xl shrink-0"><i class="fas fa-sync-alt"></i></div>
                        <div>
                            <h3 class="text-xl font-bold text-gray-900">Đồng bộ thứ tự 2 File</h3>
                            <p class="text-sm text-gray-500 font-medium mt-0.5">Xếp File 2 theo đúng thứ tự danh sách của File Mẫu (File 1).</p>
                        </div>
                    </div>
                    
                    <div class="space-y-4 mt-2">
                        <!-- Khối File 1 (Mẫu) -->
                        <div class="bg-gray-50 p-4 rounded-2xl border border-gray-200 relative">
                            <span class="absolute -top-2.5 left-4 bg-gray-600 text-white text-[10px] font-black px-2 py-0.5 rounded-md uppercase tracking-wider">File 1 (Mẫu gốc)</span>
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mb-3">
                                <div class="flex items-center gap-2 bg-white px-3 py-2 rounded-xl border border-gray-200 shadow-sm">
                                    <label class="text-xs font-bold text-gray-500">Cột Tên:</label>
                                    <input type="text" id="sync-col-1" placeholder="VD: B" class="bg-transparent w-full uppercase outline-none text-sm font-black text-gray-800 text-center">
                                </div>
                                <div class="flex items-center gap-2 bg-white px-3 py-2 rounded-xl border border-gray-200 shadow-sm">
                                    <label class="text-xs font-bold text-gray-500">Từ dòng:</label>
                                    <input type="number" id="sync-start-1" min="1" placeholder="5" class="bg-transparent w-full outline-none text-sm font-black text-gray-800 text-center">
                                </div>
                                <div class="flex items-center gap-2 bg-white px-3 py-2 rounded-xl border border-gray-200 shadow-sm">
                                    <label class="text-xs font-bold text-gray-500">Đến dòng:</label>
                                    <input type="number" id="sync-end-1" min="1" placeholder="40" class="bg-transparent w-full outline-none text-sm font-black text-gray-800 text-center">
                                </div>
                            </div>
                            <label class="w-full flex items-center justify-center gap-2 bg-white border border-gray-300 text-gray-600 hover:text-emerald-600 hover:border-emerald-300 px-3 py-2.5 rounded-xl font-bold cursor-pointer transition text-sm shadow-sm">
                                <span id="file-name-sync-1"><i class="fas fa-file-upload mr-1"></i> Tải lên File Mẫu</span>
                                <input type="file" id="util-sync-file-1" accept=".xlsx, .xls" class="hidden" onchange="updateUtilFileName(this, 'file-name-sync-1', 'emerald')">
                            </label>
                        </div>

                        <!-- Khối File 2 (Cần sắp xếp) -->
                        <div class="bg-emerald-50/30 p-4 rounded-2xl border border-emerald-100 relative">
                            <span class="absolute -top-2.5 left-4 bg-emerald-500 text-white text-[10px] font-black px-2 py-0.5 rounded-md uppercase tracking-wider">File 2 (Cần xử lý)</span>
                            <div class="grid grid-cols-1 md:grid-cols-3 gap-3 mb-3">
                                <div class="flex items-center gap-2 bg-white px-3 py-2 rounded-xl border border-emerald-200 shadow-sm">
                                    <label class="text-xs font-bold text-emerald-600">Cột Tên:</label>
                                    <input type="text" id="sync-col-2" placeholder="VD: C" class="bg-transparent w-full uppercase outline-none text-sm font-black text-emerald-800 text-center">
                                </div>
                                <div class="flex items-center gap-2 bg-white px-3 py-2 rounded-xl border border-emerald-200 shadow-sm">
                                    <label class="text-xs font-bold text-emerald-600">Từ dòng:</label>
                                    <input type="number" id="sync-start-2" min="1" placeholder="8" class="bg-transparent w-full outline-none text-sm font-black text-emerald-800 text-center">
                                </div>
                                <div class="flex items-center gap-2 bg-white px-3 py-2 rounded-xl border border-emerald-200 shadow-sm">
                                    <label class="text-xs font-bold text-emerald-600">Đến dòng:</label>
                                    <input type="number" id="sync-end-2" min="1" placeholder="42" class="bg-transparent w-full outline-none text-sm font-black text-emerald-800 text-center">
